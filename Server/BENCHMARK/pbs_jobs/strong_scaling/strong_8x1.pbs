#!/bin/sh
#PBS -q sc16
#PBS -l select=1:ncpus=8:mpiprocs=8:ompthreads=1
#PBS -l walltime=00:30:00
#PBS -N strong_8x1
#PBS -j oe
#PBS -P job

set -eu

BENCHMARK_DIR=$PBS_O_WORKDIR
REPO_ROOT=$(CDPATH= cd -- "$BENCHMARK_DIR/.." && pwd)
cd "$REPO_ROOT"

. /etc/profile.d/modules.sh
module load cuda/11.4
module load gnu/cur
module load intel/2023.2.1
module load mpt/2.23-ga

export OMP_NUM_THREADS=1
export KMP_AFFINITY=disabled

EXECUTABLE='Example/C/s86_mpi_omp/ens_Hydrogen_unstruct_mpi4/run'
case "$EXECUTABLE" in
  /*) EXEC_PATH="$EXECUTABLE" ;;
  *) EXEC_PATH="$REPO_ROOT/$EXECUTABLE" ;;
esac

OUTPUT_DIR="$BENCHMARK_DIR/benchmark_results/strong_8x1"
LOG_FILE="$BENCHMARK_DIR/benchmark_results/strong_8x1/strong_8x1.log"
mkdir -p "$OUTPUT_DIR"

echo "CASE=strong_8x1"
echo "PHASE=strong_scaling"
echo "PBS_NODEFILE=$PBS_NODEFILE"
echo "REPO_ROOT=$REPO_ROOT"
echo "BENCHMARK_DIR=$BENCHMARK_DIR"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS"
echo "COMMAND=mpirun omplace -nt ${OMP_NUM_THREADS} $EXEC_PATH "

mpirun omplace -nt ${OMP_NUM_THREADS} "$EXEC_PATH"  > "$LOG_FILE" 2>&1
