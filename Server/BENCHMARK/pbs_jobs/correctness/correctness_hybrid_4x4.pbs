#!/bin/sh
#PBS -q sc16
#PBS -l select=1:ncpus=16:mpiprocs=4:ompthreads=4
#PBS -l walltime=00:30:00
#PBS -N correctness_hyb
#PBS -j oe
#PBS -P job

set -eu

BENCHMARK_DIR=$PBS_O_WORKDIR
REPO_ROOT=$(CDPATH= cd -- "$BENCHMARK_DIR/.." && pwd)
cd "$REPO_ROOT"

. /etc/profile.d/modules.sh
module load intel/cur
module load mpt/cur

export OMP_NUM_THREADS=4
export KMP_AFFINITY=disabled

EXECUTABLE='Example/C/s86_mpi_omp/ens_Hydrogen_unstruct_mpi4/run'
case "$EXECUTABLE" in
  /*) EXEC_PATH="$EXECUTABLE" ;;
  *) EXEC_PATH="$REPO_ROOT/$EXECUTABLE" ;;
esac

OUTPUT_DIR="$BENCHMARK_DIR/benchmark_results/correctness_hybrid_4x4"
LOG_FILE="$BENCHMARK_DIR/benchmark_results/correctness_hybrid_4x4/correctness_hybrid_4x4.log"
mkdir -p "$OUTPUT_DIR"

echo "CASE=correctness_hybrid_4x4"
echo "PHASE=correctness"
echo "PBS_NODEFILE=$PBS_NODEFILE"
echo "REPO_ROOT=$REPO_ROOT"
echo "BENCHMARK_DIR=$BENCHMARK_DIR"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS"
echo "COMMAND=mpirun omplace -nt ${OMP_NUM_THREADS} $EXEC_PATH "

mpirun omplace -nt ${OMP_NUM_THREADS} "$EXEC_PATH"  > "$LOG_FILE" 2>&1
