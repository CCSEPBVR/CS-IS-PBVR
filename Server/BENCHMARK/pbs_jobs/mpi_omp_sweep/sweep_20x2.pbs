#!/bin/sh
#PBS -q sc16
#PBS -l select=1:ncpus=40:mpiprocs=20:ompthreads=2
#PBS -l walltime=00:30:00
#PBS -N sweep_20x2
#PBS -j oe
#PBS -P job

set -eu

BENCHMARK_DIR=$PBS_O_WORKDIR
REPO_ROOT=$(CDPATH= cd -- "$BENCHMARK_DIR/.." && pwd)
cd "$REPO_ROOT"

. /etc/profile.d/modules.sh
module purge
module load cuda/11.4
module load gnu/cur
module load intel/2023.2.1
module load mpt/2.23-ga

export OMP_NUM_THREADS=2
export KMP_AFFINITY=disabled

EXECUTABLE='Example/C/s86_mpi_omp/ens_Hydrogen_unstruct/run'
case "$EXECUTABLE" in
  /*) EXEC_PATH="$EXECUTABLE" ;;
  *) EXEC_PATH="$REPO_ROOT/$EXECUTABLE" ;;
esac
EXEC_DIR=$(dirname "$EXEC_PATH")
export VIS_PARAM_DIR="$EXEC_DIR"
export PARTICLE_DIR="$EXEC_DIR/particle_out"

OUTPUT_DIR="$BENCHMARK_DIR/benchmark_results/sweep_20x2"
LOG_FILE="$BENCHMARK_DIR/benchmark_results/sweep_20x2/sweep_20x2.log"
mkdir -p "$OUTPUT_DIR"

echo "CASE=sweep_20x2"
echo "PHASE=mpi_omp_sweep"
echo "PBS_NODEFILE=$PBS_NODEFILE"
echo "REPO_ROOT=$REPO_ROOT"
echo "BENCHMARK_DIR=$BENCHMARK_DIR"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS"
echo "COMMAND=mpirun -n 20 omplace $EXEC_PATH "

mpirun -n 20 omplace "$EXEC_PATH"  > "$LOG_FILE" 2>&1
