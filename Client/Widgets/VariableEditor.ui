li.checked::marker { content: &quot;\2612&quot;; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Yu Gothic UI'; font-size:9pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;[Available variables]&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;qN&lt;/span&gt; ( &lt;span style=&quot; text-decoration: underline;&quot;&gt;N=1 ~ 23&lt;/span&gt; )&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;x&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;y&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;z&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;dqNx&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;dqNy&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;dqNz&lt;/span&gt; ( &lt;span style=&quot; text-decoration: underline;&quot;&gt;N=1 ~ 23&lt;/span&gt; )&lt;/p&gt;
&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;br /&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;[Available operators]&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Binary operators:&lt;span style=&quot; font-weight:700;&quot;&gt; +&lt;/span&gt;,&lt;span style=&quot; font-weight:700;&quot;&gt; -&lt;/span&gt;,&lt;span style=&quot; font-weight:700;&quot;&gt; *&lt;/span&gt;,&lt;span style=&quot; font-weight:700;&quot;&gt; /&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Functions: &lt;span style=&quot; font-weight:700;&quot;&gt;sqrt()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;cbrt()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;log()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;log10()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;exp()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;abs()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;floor()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;ceil()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;sin()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;cos()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;tan()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;asin()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;sinh()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;cosh()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;tanh()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;asinh()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;acosh()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;atanh()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;heavi()&lt;/span&gt;, &lt;span style=&quot; font-weight:700;&quot;&gt;rectfunc()&lt;/span&gt;&lt;/p&gt;
