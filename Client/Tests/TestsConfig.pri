# ============================================================
# IS-PBVR(In-Situ)専用テスト — 上の CS 系とは別枠。別々に実行すること。
# 既存のテストフレームワークは IS-PBVR 非対応のため、IS-PBVR 専用の項目はここに集約する。
# 実行には IS モードのサーバ + アンサンブルシミュレーション(ens_Hydrogen_unstruct)が必要。
# CS 系と同時に有効化しない(1 プロセスで接続モードを共有するため)。
# ============================================================
TEST_ENABLE_ENSEMBLE_TRANSFER_FUNCTION = 0
TEST_ENABLE_REPETITIONLEVELCONTROL_INSITU = 0
TEST_ENABLE_ENSEMBLE_INSITU_MODE = 0
